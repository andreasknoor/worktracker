<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\WorkTrackerTracker.Core\WorkTrackerTracker.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Lets this project restore/compile on non-Windows hosts (e.g. macOS) for
         editing and static checking. It does NOT make the app runnable or
         testable here — GetLastInputInfo and NotifyIcon still need a real
         Windows runtime. See ../../README.md. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Self-contained publish bundles the .NET Desktop Runtime into the
         output, so the published .exe runs without installing anything —
         needed because autostart happens without admin rights to install
         the shared runtime. See windows-tracker/README.md. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

</Project>