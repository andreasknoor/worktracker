# Postgres connection string (auto-populated by the Neon Vercel integration).
DATABASE_URL=

# IANA time zone used for all day-boundary computations (see docs/IMPLEMENTATION_NOTES.md D1).
APP_TIME_ZONE=Europe/Berlin

# Shared dashboard password (see docs/IMPLEMENTATION_NOTES.md D3). Choose your own value.
DASHBOARD_PASSWORD=

# High-entropy secret used to sign the dashboard session cookie. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
DASHBOARD_SESSION_SECRET=
